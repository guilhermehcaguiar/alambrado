{
  "name": "alambrado",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "catalog:validate": "node --no-warnings --env-file-if-exists=.env --import ./scripts/import-hook.mjs scripts/import-catalog.mts --validate-only",
    "catalog:dry-run": "node --no-warnings --env-file-if-exists=.env --import ./scripts/import-hook.mjs scripts/import-catalog.mts --dry-run",
    "catalog:import": "node --no-warnings --env-file-if-exists=.env --import ./scripts/import-hook.mjs scripts/import-catalog.mts",
    "catalog:import:overwrite": "node --no-warnings --env-file-if-exists=.env --import ./scripts/import-hook.mjs scripts/import-catalog.mts --overwrite",
    "catalog:generate": "node --no-warnings --import ./scripts/import-hook.mjs scripts/generate-catalog.mts",
    "catalog:generate:dry-run": "node --no-warnings --import ./scripts/import-hook.mjs scripts/generate-catalog.mts --dry-run",
    "catalog:delete": "node --no-warnings --env-file-if-exists=.env --import ./scripts/import-hook.mjs scripts/delete-product.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
