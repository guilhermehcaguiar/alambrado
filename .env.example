NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service Role (contorna RLS) — usada SOMENTE por scripts locais (import/delete).
# Nunca importe em Client Component nem a use na aplicação web.
SUPABASE_SERVICE_ROLE_KEY=
# Número do WhatsApp para o checkout, somente no servidor, apenas dígitos no formato internacional (ex.: 5581XXXXXXXXX)
WHATSAPP_NUMBER=
# URL pública de produção (usada em canonical/sitemap/Open Graph). Na Vercel,
# o Next.js usa VERCEL_PROJECT_PRODUCTION_URL como fallback se não definida.
NEXT_PUBLIC_SITE_URL=
